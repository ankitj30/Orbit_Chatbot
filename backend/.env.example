# ==============================================================================
# Orbit Chatbot - Backend Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or real secrets to version control!

# Server Port (default: 5000)
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection String
# Example format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/<database_name>?retryWrites=true&w=majority

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret Key (Generate with: openssl rand -base64 32)
# CRITICAL: Do NOT leave blank or use default 'secret' in production!
JWT_SECRET=your_secure_jwt_secret_key_here

# Frontend Application URL (Used for CORS and shareable links)
FRONTEND_URL=http://localhost:5173

